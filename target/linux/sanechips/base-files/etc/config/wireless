config wifi-device 'radio0'
	option type 'mac80211'
	option phy 'phy0'
	option band '2g'
	option channel '1'
	option htmode 'HT20'
	option country 'IN'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'OpenWrt-F670L'
	option encryption 'none'
	option disabled '0'

config wifi-device 'radio1'
	option type 'mac80211'
	option phy 'phy1'
	option band '5g'
	option channel '36'
	option htmode 'VHT80'
	option country 'IN'
	option disabled '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'OpenWrt-F670L-5G'
	option encryption 'none'
	option disabled '0'
