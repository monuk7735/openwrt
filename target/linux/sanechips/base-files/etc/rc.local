#!/bin/sh
# ZTE ZXHN F670L Startup & Wireless Bringup Script

CONSOLE=/dev/ttyAMA0
log() {
    echo "$@" > $CONSOLE 2>/dev/null || echo "$@"
}

log ""
log "=========================================================="
log "  OPENWRT / LINUX 6.18 - ZTE ZXHN F670L                   "
log "  Dual-Core ARM Cortex-A9 (Sanechips ZX279128)            "
log "  System Uptime: $(cut -d' ' -f1 /proc/uptime)s           "
log "=========================================================="
log "--> Initializing Wi-Fi, DHCP, and Web UI..."

# Ensure wireless drivers are loaded
modprobe mt7603e 2>/dev/null
modprobe mt76x2e 2>/dev/null

# Stop the idling OpenWrt dummy hostapd listener so it doesn't block radio binding
/etc/init.d/wpad stop 2>/dev/null
killall -9 hostapd 2>/dev/null

# Ensure br-lan bridge exists with static IP 192.168.1.1
ip link add name br-lan type bridge 2>/dev/null
ip addr add 192.168.1.1/24 dev br-lan 2>/dev/null
ip link set br-lan up 2>/dev/null

# Ensure LAN switch ports are up and joined to br-lan
for eth in lan1 lan2 lan3 lan4; do
    if [ -d "/sys/class/net/$eth" ]; then
        log "--> Bringing up $eth and joining to br-lan..."
        ip link set "$eth" up > $CONSOLE 2>&1
        brctl addif br-lan "$eth" > $CONSOLE 2>&1 || ip link set "$eth" master br-lan > $CONSOLE 2>&1
    fi
done

# Wait briefly for wireless phys to appear in sysfs
for i in 1 2 3 4 5; do
    if [ -d /sys/class/ieee80211/phy0 ] || [ -d /sys/class/ieee80211/phy1 ]; then
        break
    fi
    sleep 1
done

# Sysfs diagnostics
log "--> /sys/class/ieee80211: $(ls /sys/class/ieee80211 2>/dev/null | tr '\n' ' ')"
log "--> /sys/class/net: $(ls /sys/class/net 2>/dev/null | tr '\n' ' ')"

# Set wireless regulatory country to India (IN)
iw reg set IN 2>/dev/null

# Deterministically find 2.4G (MT7603E) and 5G (MT7612E) phys
PHY2G=""
PHY5G=""
for p in /sys/bus/pci/drivers/mt7603e/*:*/ieee80211/phy*; do
    [ -d "$p" ] && PHY2G=$(basename "$p")
done
for p in /sys/bus/pci/drivers/mt76x2e/*:*/ieee80211/phy*; do
    [ -d "$p" ] && PHY5G=$(basename "$p")
done

# Fallback defaults if sysfs driver path was not yet populated
[ -z "$PHY2G" ] && PHY2G="phy0"
[ -z "$PHY5G" ] && PHY5G="phy1"

log "--> Detected Radios: 2.4GHz=$PHY2G (MT7603E), 5GHz=$PHY5G (MT7612E)"

# Bring up 2.4 GHz AP
if [ -n "$PHY2G" ] && [ -d "/sys/class/net" ]; then
    log "--> Setting up 2.4GHz AP on $PHY2G (wlan0)..."
    iw phy "$PHY2G" interface add wlan0 type __ap > $CONSOLE 2>&1
    ip link set wlan0 up > $CONSOLE 2>&1
    brctl addif br-lan wlan0 > $CONSOLE 2>&1 || ip link set wlan0 master br-lan > $CONSOLE 2>&1

    cat << 'EOF' > /etc/hostapd-phy0.conf
interface=wlan0
driver=nl80211
ssid=OpenWrt-F670L
hw_mode=g
channel=1
country_code=IN
ieee80211d=1
auth_algs=1
wmm_enabled=1
ieee80211n=1
ht_capab=[HT20]
EOF
    log "--> Launching hostapd on wlan0 (2.4GHz, Country IN)..."
    /usr/sbin/hostapd -B /etc/hostapd-phy0.conf > $CONSOLE 2>&1
fi

# Bring up 5.0 GHz AP
if [ -n "$PHY5G" ] && [ -d "/sys/class/net" ]; then
    log "--> Setting up 5GHz AP on $PHY5G (wlan1)..."
    iw phy "$PHY5G" interface add wlan1 type __ap > $CONSOLE 2>&1
    ip link set wlan1 up > $CONSOLE 2>&1
    brctl addif br-lan wlan1 > $CONSOLE 2>&1 || ip link set wlan1 master br-lan > $CONSOLE 2>&1

    cat << 'EOF' > /etc/hostapd-phy1.conf
interface=wlan1
driver=nl80211
ssid=OpenWrt-F670L-5G
hw_mode=a
channel=36
country_code=IN
ieee80211d=1
ieee80211h=1
auth_algs=1
wmm_enabled=1
ieee80211n=1
ht_capab=[HT20]
EOF
    log "--> Launching hostapd on wlan1 (5GHz, Country IN)..."
    /usr/sbin/hostapd -B /etc/hostapd-phy1.conf > $CONSOLE 2>&1
fi

# Start dnsmasq DHCP server on br-lan
killall dnsmasq 2>/dev/null
if [ -x /usr/sbin/dnsmasq ]; then
    log "--> Starting dnsmasq DHCP server (192.168.1.100 - 192.168.1.249)..."
    /usr/sbin/dnsmasq \
        --interface=br-lan \
        --bind-interfaces \
        --dhcp-range=192.168.1.100,192.168.1.249,255.255.255.0,12h \
        --dhcp-option=3,192.168.1.1 \
        --dhcp-option=6,192.168.1.1 \
        --dhcp-leasefile=/tmp/dhcp.leases \
        --domain=lan \
        --local=/lan/ > $CONSOLE 2>&1 &
fi

# Start rpcd session service (required by LuCI for authentication)
killall rpcd 2>/dev/null
if [ -x /etc/init.d/rpcd ]; then
    log "--> Starting rpcd session service..."
    /etc/init.d/rpcd start > $CONSOLE 2>&1
fi

# Start OpenWrt LuCI Web Server (uhttpd) on port 80
killall uhttpd httpd 2>/dev/null
if [ -x /etc/init.d/uhttpd ]; then
    log "--> Starting LuCI Web Interface on port 80..."
    /etc/init.d/uhttpd start > $CONSOLE 2>&1
fi

sleep 1

log ""
log "=========================================================="
log "  ZTE ZXHN F670L IS READY!                                "
log "  ------------------------------------------------------- "
[ -n "$PHY2G" ] && log "  Wi-Fi 2.4GHz SSID: OpenWrt-F670L  (Channel 1, Open)     "
[ -n "$PHY5G" ] && log "  Wi-Fi 5.0GHz SSID: OpenWrt-F670L-5G (Channel 36, Open)  "
log "  Web UI URL       : http://192.168.1.1/                  "
log "  DHCP IP Range    : 192.168.1.100 - 192.168.1.249        "
log "  Active services  :"
ps | grep -E "hostapd|dnsmasq|uhttpd|rpcd" | grep -v grep | while read line; do
    log "    $line"
done
log "  Wireless dev info:"
iw dev 2>&1 | while read line; do
    log "    $line"
done
log "  Network interfaces:"
ip addr show 2>&1 | grep -E "^[0-9]+:|inet " | while read line; do
    log "    $line"
done
log "  System & Network / PCIe / Wi-Fi kernel logs:"
dmesg | grep -iE "mdio|gmac|phy|eth|cma|switch|pci|mt76" | while read line; do
    log "    $line"
done
log "=========================================================="
log ""

exit 0
