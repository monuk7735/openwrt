+static void zte_early_putc(struct uart_port *port, unsigned char c)
+{
+	while (readl(port->membase + ZX_UART011_FR) & BIT(5))
+		cpu_relax();
+	writel(c, port->membase + ZX_UART011_DR);
+}
+
+static void zte_early_write(struct console *con, const char *s, unsigned int n)
+{
+	struct earlycon_device *dev = con->data;
+
+	uart_console_write(&dev->port, s, n, zte_early_putc);
+}
+
+static int __init zte_early_console_setup(struct earlycon_device *device,
+					  const char *opt)
+{
+	if (!device->port.membase)
+		return -ENODEV;
+
+	device->con->write = zte_early_write;
+	return 0;
+}
+
+EARLYCON_DECLARE(zteuart, zte_early_console_setup);
