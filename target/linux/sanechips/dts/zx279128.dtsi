#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "zte,zx279128", "zte,zx279128-smp";

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		enable-method = "zte,zx279128-smp";

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <0>;
			next-level-cache = <&l2>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <1>;
			next-level-cache = <&l2>;
		};
	};

	clocks {
		osc24m: osc24m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <24000000>;
		};

		clk_uart: clk_uart {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <25000000>;
		};

		clk_arm: clk_arm {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <800000000>;
		};

		clk_periph: clk_periph {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <400000000>;
		};
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		interrupt-parent = <&gic>;
		ranges;

		gic: interrupt-controller@801000 {
			compatible = "arm,cortex-a9-gic";
			#interrupt-cells = <3>;
			interrupt-controller;
			reg = <0x00801000 0x1000>,
			      <0x00800100 0x100>;
		};

		global_timer: timer@800200 {
			compatible = "arm,cortex-a9-global-timer";
			reg = <0x00800200 0x20>;
			interrupts = <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(2) | IRQ_TYPE_LEVEL_HIGH)>;
			clocks = <&clk_periph>;
		};

		twd_timer: timer@800600 {
			compatible = "arm,cortex-a9-twd-timer";
			reg = <0x00800600 0x20>;
			interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(2) | IRQ_TYPE_EDGE_RISING)>;
			clocks = <&clk_periph>;
		};

		twd_wdt: watchdog@800620 {
			compatible = "arm,cortex-a9-twd-wdt";
			reg = <0x00800620 0x20>;
			interrupts = <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(2) | IRQ_TYPE_EDGE_RISING)>;
			clocks = <&clk_periph>;
		};

		l2: l2-cache-controller@c00000 {
			compatible = "arm,pl310-cache";
			reg = <0x00c00000 0x1000>;
			cache-unified;
			cache-level = <2>;
			arm,data-latency = <2 2 2>;
			arm,tag-latency = <2 2 2>;
			arm,shared-override;
		};

		timer1: timer@94402000 {
			compatible = "zxic,apb-timer1", "syscon";
			reg = <0x94402000 0x1000>;
			interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>;
		};

		topcrm: syscon@94000000 {
			compatible = "zte,ZX279127-topcrm", "syscon";
			reg = <0x94000000 0x1000>;
			#clock-cells = <1>;
		};

		lsp0crpm: syscon@94400000 {
			compatible = "zte,ZX279127-lsp0crpm", "syscon";
			reg = <0x94400000 0x1000>;
			#clock-cells = <1>;
		};

		uart0: serial@94405000 {
			compatible = "arm,pl011", "arm,primecell";
			arm,primecell-periphid = <0x001feffe>;
			reg = <0x94405000 0x1000>;
			interrupts = <GIC_SPI 10 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_uart>, <&clk_uart>;
			clock-names = "uartclk", "apb_pclk";
			status = "disabled";
		};

		uart1: serial@94406000 {
			compatible = "arm,pl011", "arm,primecell";
			arm,primecell-periphid = <0x001feffe>;
			reg = <0x94406000 0x1000>;
			interrupts = <GIC_SPI 9 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_uart>, <&clk_uart>;
			clock-names = "uartclk", "apb_pclk";
			status = "disabled";
		};

		spifc: spi-flash-controller@94407000 {
			compatible = "zte,ZX27912x-spifc", "syscon";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x94407000 0x1000>;
			reg-names = "spifc_reg";
			interrupts = <GIC_SPI 8 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		lsp1crpm: syscon@9a100000 {
			compatible = "zte,ZX279127-lsp1crpm", "syscon";
			reg = <0x9a100000 0x1000>;
			#clock-cells = <1>;
		};

		mdio: mdio@9a101000 {
			compatible = "zte,zx279128s-mdio", "zte,zx279127-mdio";
			reg = <0x9a101000 0x18>;
			clocks = <&clk_uart>, <&clk_uart>;
			clock-names = "pclk", "wclk";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c0: i2c@9a102000 {
			compatible = "zte,ZX279127-i2c";
			reg = <0x9a102000 0x40>;
			interrupts = <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		ssp: spi@9a105000 {
			compatible = "zte,zx279127-ssp";
			reg = <0x9a105000 0x1000>;
			interrupts = <GIC_SPI 25 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		gmac: ethernet@92000000 {
			compatible = "zte,zx279128s-gmac";
			reg = <0x92000000 0x400000>;
			interrupts = <GIC_SPI 80 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";

			ethernet-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				gmac_port0: port@0 {
					reg = <0>;
					status = "disabled";
				};

				gmac_port1: port@1 {
					reg = <1>;
					status = "disabled";
				};

				gmac_port2: port@2 {
					reg = <2>;
					status = "disabled";
				};

				gmac_port3: port@3 {
					reg = <3>;
					status = "disabled";
				};

				gmac_port4: port@4 {
					reg = <4>;
					status = "disabled";
				};
			};
		};

		pcie0: pcie@10000000 {
			compatible = "zte,zx279128-pcie", "snps,dw-pcie";
			reg = <0x0f000000 0x4000>,
			      <0x1c000000 0x10000>,
			      <0x09500000 0x1000>;
			reg-names = "dbi", "config", "phy";
			#address-cells = <3>;
			#size-cells = <2>;
			device_type = "pci";
			ranges = <0x82000000 0 0x10000000 0x10000000 0 0x08000000>;
			num-lanes = <1>;
			bus-range = <0x00 0xff>;
			interrupts = <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "sts";
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 0x7>;
			interrupt-map = <0 0 0 1 &gic GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>,
			                <0 0 0 2 &gic GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>,
			                <0 0 0 3 &gic GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>,
			                <0 0 0 4 &gic GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>;
			port-id = <0>;
			status = "disabled";
		};

		pcie1: pcie@20000000 {
			compatible = "zte,zx279128-pcie", "snps,dw-pcie";
			reg = <0x0f100000 0x4000>,
			      <0x2c000000 0x10000>,
			      <0x09600000 0x1000>;
			reg-names = "dbi", "config", "phy";
			#address-cells = <3>;
			#size-cells = <2>;
			device_type = "pci";
			ranges = <0x82000000 0 0x20000000 0x20000000 0 0x08000000>;
			num-lanes = <1>;
			bus-range = <0x00 0xff>;
			interrupts = <GIC_SPI 60 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "sts";
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 0x7>;
			interrupt-map = <0 0 0 1 &gic GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>,
			                <0 0 0 2 &gic GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>,
			                <0 0 0 3 &gic GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>,
			                <0 0 0 4 &gic GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>;
			port-id = <1>;
			status = "disabled";
		};

		usb_dwc2: usb@9000000 {
			compatible = "zte,zx279127-dwc2", "snps,dwc2";
			reg = <0x09000000 0x10000>;
			interrupts = <GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH>;
			dr_mode = "host";
			status = "disabled";
		};

		usb_dwc3: usb@9100000 {
			compatible = "zte,zx279128-dwc3", "snps,dwc3";
			reg = <0x09100000 0x10000>;
			interrupts = <GIC_SPI 59 IRQ_TYPE_LEVEL_HIGH>;
			dr_mode = "host";
			status = "disabled";
		};
	};
};
